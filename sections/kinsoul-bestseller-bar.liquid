{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<div
  class="kinsoul-bestseller-section color-{{ color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="kinsoul-bestseller__header" data-kinsoul-reveal="up">
        {%- if section.settings.subheading != blank -%}
          <p class="kinsoul-bestseller__eyebrow">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kinsoul-bestseller__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="kinsoul-bestseller__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link_url | default: '#' }}"
          class="kinsoul-bestseller__card"
          data-kinsoul-reveal="up"
          data-kinsoul-delay="{{ forloop.index0 | times: 100 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.tag_text != blank -%}
            <span class="kinsoul-bestseller__tag">{{ block.settings.tag_text }}</span>
          {%- endif -%}

          <h3 class="kinsoul-bestseller__card-label">{{ block.settings.label }}</h3>

          {%- if block.settings.subtext != blank -%}
            <p class="kinsoul-bestseller__card-sub">{{ block.settings.subtext }}</p>
          {%- endif -%}

          {%- if block.settings.cta_text != blank -%}
            <span class="kinsoul-bestseller__card-cta">{{ block.settings.cta_text }} →</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Best Seller Bar",
  "tag": "section",
  "class": "kinsoul-bestseller-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where to Start"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Piece Faster"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "quick_card",
      "name": "Quick Entry Card",
      "settings": [
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag (optional)",
          "default": "Under $200"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Main label",
          "default": "Start Here"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Supporting text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Best Seller Bar",
      "blocks": [
        {
          "type": "quick_card",
          "settings": {
            "tag_text": "Entry",
            "label": "Under $200",
            "subtext": "Start with Soleil or Serenity — our most approachable pieces.",
            "link_url": "/collections/shop-all-bracelets?sort_by=price-ascending",
            "cta_text": "Shop under $200"
          }
        },
        {
          "type": "quick_card",
          "settings": {
            "tag_text": "Most loved",
            "label": "Serenity",
            "subtext": "Amethyst + freshwater pearl. The one people keep gifting.",
            "link_url": "/products/freeform-amethyst-bracelet-with-freshwater-pearls",
            "cta_text": "See Serenity"
          }
        },
        {
          "type": "quick_card",
          "settings": {
            "tag_text": "The signature",
            "label": "Aura",
            "subtext": "From a curated palette of 12 natural stones — our most complex piece.",
            "link_url": "/products/aura-balance-bracelet-baroque-pearl-crystal-mixed-gemstones",
            "cta_text": "See Aura"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign image = section.settings.image
-%}

<div
  class="kinsoul-founder-lockup-section color-{{ color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="kinsoul-founder-lockup">
      <div class="kinsoul-founder-lockup__image-wrap" data-kinsoul-reveal="up">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 900',
              sizes: '(max-width: 749px) 100vw, 45vw',
              class: 'kinsoul-founder-lockup__image',
              alt: image.alt | default: 'LU, founder of Kinsoul Energy'
          }}
        {%- else -%}
          <div class="kinsoul-founder-lockup__placeholder">
            {{ 'collection-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <div class="kinsoul-founder-lockup__content" data-kinsoul-reveal="up" data-kinsoul-delay="150">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kinsoul-founder-lockup__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="kinsoul-founder-lockup__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body_text != blank -%}
          <div class="kinsoul-founder-lockup__text">{{ section.settings.body_text }}</div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <p class="kinsoul-founder-lockup__signature">{{ section.settings.signature }}</p>
        {%- endif -%}

        {%- if section.settings.cta_url != blank and section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url }}" class="kinsoul-founder-lockup__cta">
            {{ section.settings.cta_text }} →
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Founder Lockup",
  "tag": "section",
  "class": "kinsoul-founder-lockup-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Founder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In 2018, a designer named LU found a stone on the ground in China."
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>She picked it up, turned it over in her hand, and saw something most people walked past every day — a small piece of the earth, shaped slowly over time, holding a quiet weight. That moment turned into a question: what if jewelry could be made the way the stone was made — slowly, by hand, from the natural world rather than the factory floor? Kinsoul Energy is the answer she's been building ever since, one bracelet at a time.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": "— LU, founder"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link",
      "default": "/pages/about"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA label",
      "default": "Read our story"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Founder Lockup"
    }
  ]
}
{% endschema %}

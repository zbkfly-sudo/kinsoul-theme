{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<section
  class="kinsoul-durability section-{{ section.id }} color-{{ color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="kinsoul-durability-heading-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="kinsoul-durability__header" data-kinsoul-reveal="up">
        {%- if section.settings.subheading != blank -%}
          <p class="kinsoul-durability__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <h2 class="kinsoul-durability__title" id="kinsoul-durability-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        <hr class="kinsoul-divider">
        {%- if section.settings.description != blank -%}
          <p class="kinsoul-durability__desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="kinsoul-durability__grid" data-kinsoul-stagger="120">
      {%- for block in section.blocks -%}
        <li class="kinsoul-durability__item" data-kinsoul-stagger-child {{ block.shopify_attributes }}>
          {%- if block.settings.timeframe != blank -%}
            <p class="kinsoul-durability__timeframe">{{ block.settings.timeframe }}</p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="kinsoul-durability__item-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.observation != blank -%}
            <div class="kinsoul-durability__observation">{{ block.settings.observation }}</div>
          {%- endif -%}
          {%- if block.settings.action != blank -%}
            <div class="kinsoul-durability__action">
              <p class="kinsoul-durability__action-label">What to do</p>
              <div class="kinsoul-durability__action-text">{{ block.settings.action }}</div>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.footnote != blank -%}
      <p class="kinsoul-durability__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .kinsoul-durability__header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .kinsoul-durability__subheading {
    font-family: var(--font-secondary--family), sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--kinsoul-accent, #7B6B5D);
    margin-bottom: 1rem;
  }
  .kinsoul-durability__title {
    font-family: var(--font-heading--family), serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--color-foreground-heading);
    letter-spacing: 0.03em;
    margin: 0;
  }
  .kinsoul-durability__desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--kinsoul-text, #4A4A4A);
    margin-top: 1.25rem;
  }
  .kinsoul-durability__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .kinsoul-durability__item {
    padding: 2rem 1.75rem;
    background: var(--kinsoul-bg-soft, rgba(249, 246, 241, 0.5));
    border: 1px solid var(--kinsoul-border, #E0D8CE);
    border-radius: var(--kinsoul-radius-soft, 2px);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .kinsoul-durability__timeframe {
    font-family: var(--font-heading--family), serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--kinsoul-accent, #7B6B5D);
    letter-spacing: 0.02em;
    margin: 0;
    line-height: 1.1;
  }
  .kinsoul-durability__item-title {
    font-family: var(--font-heading--family), serif;
    font-size: 1rem;
    font-weight: 400;
    color: var(--kinsoul-heading, #2C2C2C);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.3;
  }
  .kinsoul-durability__observation {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--kinsoul-text, #4A4A4A);
    flex: 1;
  }
  .kinsoul-durability__observation p { margin: 0 0 0.6rem; }
  .kinsoul-durability__observation p:last-child { margin-bottom: 0; }
  .kinsoul-durability__action {
    padding-top: 0.75rem;
    border-top: 1px solid var(--kinsoul-border, #E0D8CE);
  }
  .kinsoul-durability__action-label {
    font-family: var(--font-secondary--family), sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--kinsoul-accent, #7B6B5D);
    margin: 0 0 0.35rem;
  }
  .kinsoul-durability__action-text {
    font-size: 0.83rem;
    line-height: 1.65;
    color: var(--kinsoul-text, #4A4A4A);
  }
  .kinsoul-durability__action-text p { margin: 0; }
  .kinsoul-durability__footnote {
    margin-top: 2.5rem;
    font-size: 0.78rem;
    text-align: center;
    color: var(--kinsoul-muted, #7B6B5D);
    font-style: italic;
    max-width: 640px;
    margin-inline: auto;
  }
  @media screen and (max-width: 989px) {
    .kinsoul-durability__grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kinsoul Materials Durability",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "First-party wear testing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How each material ages on the wrist"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We wear-test every piece from our own lineup in our own studio before we publish a lifespan. The observations below are what we've actually seen, not industry averages or marketing claims."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Observations under normal daily wear. Continuous direct sun, saltwater, lotions, and perfumes shorten every timeline. See Client Care for full care guidance."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "observation",
      "name": "Wear-test observation",
      "settings": [
        { "type": "text", "id": "timeframe", "label": "Timeframe (e.g. ~3 months)", "default": "~3 months" },
        { "type": "text", "id": "title", "label": "Material", "default": "S925 sterling silver" },
        { "type": "richtext", "id": "observation", "label": "What we've observed" },
        { "type": "richtext", "id": "action", "label": "What to do about it" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kinsoul Materials Durability",
      "blocks": [
        { "type": "observation" },
        { "type": "observation" },
        { "type": "observation" }
      ]
    }
  ]
}
{% endschema %}

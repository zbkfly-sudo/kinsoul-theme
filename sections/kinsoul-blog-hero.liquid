{% comment %}
  Kinsoul Journal — Optional blog hero section
  (Currently kinsoul-blog-list.liquid owns the hero. This section is reserved
   for future use when/if we separate hero + list layouts.)
{% endcomment %}

<div class="kinsoul-blog-hero color-{{ section.settings.color_scheme }}" data-kinsoul-reveal="up">
  <div class="page-width kinsoul-blog-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="kinsoul-blog-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="kinsoul-blog-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="kinsoul-blog-hero__description">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kinsoul Blog Hero",
  "tag": "section",
  "class": "kinsoul-blog-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE JOURNAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes from the Studio" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Kinsoul Blog Hero" }]
}
{% endschema %}

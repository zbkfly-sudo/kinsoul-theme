{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<div
  class="kinsoul-trust-signals-section color-{{ color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="kinsoul-trust-signals__header" data-kinsoul-reveal="up">
        {%- if section.settings.subheading != blank -%}
          <p class="kinsoul-trust-signals__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kinsoul-trust-signals__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="kinsoul-trust-signals__grid">
      {%- for block in section.blocks -%}
        <li
          class="kinsoul-trust-signals__card"
          data-kinsoul-reveal="up"
          data-kinsoul-delay="{{ forloop.index0 | times: 100 }}"
          {{ block.shopify_attributes }}
        >
          <span class="kinsoul-trust-signals__icon">
            {%- if block.settings.icon_svg != blank -%}
              {{ block.settings.icon_svg }}
            {%- else -%}
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            {%- endif -%}
          </span>

          <h3 class="kinsoul-trust-signals__card-title">{{ block.settings.title }}</h3>

          {%- if block.settings.description != blank -%}
            <p class="kinsoul-trust-signals__card-desc">{{ block.settings.description }}</p>
          {%- endif -%}

          {%- if block.settings.link_url != blank and block.settings.link_label != blank -%}
            <a href="{{ block.settings.link_url }}" class="kinsoul-trust-signals__card-link">
              {{ block.settings.link_label }} →
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust Signals",
  "tag": "section",
  "class": "kinsoul-trust-signals-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Why Kinsoul"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made With Care — From Our Hands to Yours"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "signal_card",
      "name": "Trust Card",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG code"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Trust Signal"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL (optional)"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label (optional)"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust Signals",
      "blocks": [
        {
          "type": "signal_card",
          "settings": {
            "icon_svg": "<svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.3'><circle cx='12' cy='12' r='10'/><circle cx='12' cy='12' r='4'/></svg>",
            "title": "100% Natural Materials",
            "description": "Every bracelet includes a certificate of authenticity. Never synthetic, never dyed, never coated.",
            "link_url": "/pages/materials-craft",
            "link_label": "See the materials"
          }
        },
        {
          "type": "signal_card",
          "settings": {
            "icon_svg": "<svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg>",
            "title": "Made by 5 people in California",
            "description": "A small studio. Every piece is hand-assembled, weighed for balance, and inspected before it ships.",
            "link_url": "/pages/about",
            "link_label": "Meet the studio"
          }
        },
        {
          "type": "signal_card",
          "settings": {
            "icon_svg": "<svg width='28' height='28' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'><polyline points='17 1 21 5 17 9'/><path d='M3 11V9a4 4 0 0 1 4-4h14'/><polyline points='7 23 3 19 7 15'/><path d='M21 13v2a4 4 0 0 1-4 4H3'/></svg>",
            "title": "30-day returns + free size exchanges",
            "description": "If it doesn't fit right, we send another one — no cost. Email us, and we include a prepaid return label.",
            "link_url": "/pages/client-care",
            "link_label": "See our policies"
          }
        }
      ]
    }
  ]
}
{% endschema %}

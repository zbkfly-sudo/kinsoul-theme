{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<section
  class="kinsoul-sourcing section-{{ section.id }} color-{{ color_scheme }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-labelledby="kinsoul-sourcing-heading-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="kinsoul-sourcing__header" data-kinsoul-reveal="up">
        {%- if section.settings.subheading != blank -%}
          <p class="kinsoul-sourcing__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <h2 class="kinsoul-sourcing__title" id="kinsoul-sourcing-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        <hr class="kinsoul-divider">
        {%- if section.settings.description != blank -%}
          <p class="kinsoul-sourcing__desc">{{ section.settings.description }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="kinsoul-sourcing__grid" data-kinsoul-stagger="100">
      {%- for block in section.blocks -%}
        <li class="kinsoul-sourcing__item" data-kinsoul-stagger-child {{ block.shopify_attributes }}>
          {%- if block.settings.region != blank -%}
            <p class="kinsoul-sourcing__region">{{ block.settings.region }}</p>
          {%- endif -%}
          {%- if block.settings.material != blank -%}
            <h3 class="kinsoul-sourcing__material">{{ block.settings.material }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <div class="kinsoul-sourcing__text">{{ block.settings.description }}</div>
          {%- endif -%}
          {%- if block.settings.products_label != blank -%}
            <p class="kinsoul-sourcing__products-label">{{ block.settings.products_label }}</p>
          {%- endif -%}
          {%- liquid
            assign has_product_links = false
            if block.settings.product_1_url != blank or block.settings.product_2_url != blank or block.settings.product_3_url != blank
              assign has_product_links = true
            endif
          -%}
          {%- if has_product_links -%}
            <ul class="kinsoul-sourcing__products">
              {%- for i in (1..3) -%}
                {%- liquid
                  assign url_key = 'product_' | append: i | append: '_url'
                  assign name_key = 'product_' | append: i | append: '_name'
                  assign p_url = block.settings[url_key]
                  assign p_name = block.settings[name_key]
                -%}
                {%- if p_url != blank and p_name != blank -%}
                  <li><a href="{{ p_url }}">{{ p_name }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .kinsoul-sourcing__header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .kinsoul-sourcing__subheading {
    font-family: var(--font-secondary--family), sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--kinsoul-accent, #7B6B5D);
    margin-bottom: 1rem;
  }
  .kinsoul-sourcing__title {
    font-family: var(--font-heading--family), serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: var(--color-foreground-heading);
    letter-spacing: 0.03em;
    margin: 0;
  }
  .kinsoul-sourcing__desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--kinsoul-text, #4A4A4A);
    margin-top: 1.25rem;
  }
  .kinsoul-sourcing__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .kinsoul-sourcing__item {
    padding: 1.75rem 1.5rem;
    background: var(--kinsoul-bg-soft, rgba(249, 246, 241, 0.5));
    border: 1px solid var(--kinsoul-border, #E0D8CE);
    border-radius: var(--kinsoul-radius-soft, 2px);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .kinsoul-sourcing__region {
    font-family: var(--font-secondary--family), sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--kinsoul-accent, #7B6B5D);
    margin: 0;
  }
  .kinsoul-sourcing__material {
    font-family: var(--font-heading--family), serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--kinsoul-heading, #2C2C2C);
    letter-spacing: 0.02em;
    margin: 0;
    line-height: 1.3;
  }
  .kinsoul-sourcing__text {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--kinsoul-text, #4A4A4A);
  }
  .kinsoul-sourcing__text p { margin: 0 0 0.65rem; }
  .kinsoul-sourcing__text p:last-child { margin-bottom: 0; }
  .kinsoul-sourcing__products-label {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--kinsoul-accent, #7B6B5D);
    margin: 0.5rem 0 0.25rem;
  }
  .kinsoul-sourcing__products {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .kinsoul-sourcing__products a {
    color: var(--kinsoul-heading, #2C2C2C);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .kinsoul-sourcing__products a:hover {
    color: var(--kinsoul-accent, #7B6B5D);
  }
  @media screen and (max-width: 989px) {
    .kinsoul-sourcing__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 599px) {
    .kinsoul-sourcing__grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .kinsoul-sourcing__item { padding: 1.5rem 1.25rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kinsoul Sourcing",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where Our Materials Come From"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seven regions, one bracelet at a time"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every stone and pearl in a Kinsoul bracelet has a place on the map. We buy small batches monthly from the origins with the best reputation for that specific material, then hand-select each piece before it goes on a bracelet."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "region",
      "name": "Region card",
      "settings": [
        { "type": "text", "id": "region", "label": "Region label", "default": "Region" },
        { "type": "text", "id": "material", "label": "Material", "default": "Material name" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "products_label", "label": "Products label", "default": "In this bracelet" },
        { "type": "url", "id": "product_1_url", "label": "Product 1 URL" },
        { "type": "text", "id": "product_1_name", "label": "Product 1 name" },
        { "type": "url", "id": "product_2_url", "label": "Product 2 URL" },
        { "type": "text", "id": "product_2_name", "label": "Product 2 name" },
        { "type": "url", "id": "product_3_url", "label": "Product 3 URL" },
        { "type": "text", "id": "product_3_name", "label": "Product 3 name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kinsoul Sourcing",
      "blocks": [
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" },
        { "type": "region" }
      ]
    }
  ]
}
{% endschema %}

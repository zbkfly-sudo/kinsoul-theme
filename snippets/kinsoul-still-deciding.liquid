{%- doc -%}
  Kinsoul Energy — "Still deciding?" helper strip.
  Used at the bottom of the Collection page and any gift-adjacent PDP flow.
  3 cards: browse guide / ask us / care policies.
{%- enddoc -%}

<section class="kinsoul-still-deciding" aria-labelledby="kinsoul-still-deciding-heading">
  <div class="kinsoul-still-deciding__header">
    <p class="kinsoul-still-deciding__eyebrow">Not sure yet?</p>
    <h3 class="kinsoul-still-deciding__title" id="kinsoul-still-deciding-heading">
      We can help you pick
    </h3>
  </div>

  <div class="kinsoul-still-deciding__grid">
    <a href="/pages/materials-craft" class="kinsoul-still-deciding__card">
      <span class="kinsoul-still-deciding__icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M8 12c2-4 6-4 8 0"/>
          <circle cx="12" cy="12" r="2" fill="currentColor"/>
        </svg>
      </span>
      <span class="kinsoul-still-deciding__label">Read the stone guide</span>
      <span class="kinsoul-still-deciding__sub">9 stones, their origins and meanings.</span>
      <span class="kinsoul-still-deciding__cta">Learn more →</span>
    </a>

    <a href="/pages/contact" class="kinsoul-still-deciding__card">
      <span class="kinsoul-still-deciding__icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </span>
      <span class="kinsoul-still-deciding__label">Ask us directly</span>
      <span class="kinsoul-still-deciding__sub">Real people. Usually back within 4 hours PT.</span>
      <span class="kinsoul-still-deciding__cta">Message us →</span>
    </a>

    <a href="/pages/client-care" class="kinsoul-still-deciding__card">
      <span class="kinsoul-still-deciding__icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="17 1 21 5 17 9"/>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
          <polyline points="7 23 3 19 7 15"/>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        </svg>
      </span>
      <span class="kinsoul-still-deciding__label">Shipping & returns</span>
      <span class="kinsoul-still-deciding__sub">30-day returns. Free size exchanges. Ships 1–3 days.</span>
      <span class="kinsoul-still-deciding__cta">See policies →</span>
    </a>
  </div>
</section>

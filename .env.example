# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

SHOPIFY_STORE=qr4xym-qi.myshopify.com
SHOPIFY_LIVE_THEME_ID=147158990934

# Theme Access token (used by push-test.sh / sync-from-live.sh / publish.sh)
# Scope: write_themes only. Get at Shopify Admin → Apps → Theme Access.
SHOPIFY_CLI_THEME_TOKEN=shptka_REPLACE_ME

# Admin API token (used by scripts/kinsoul-admin-setup.py for pages+metafields)
# Scopes: write_products, write_content, write_files.
# Get by creating a Custom App in Dev Dashboard — see scripts/kinsoul-admin-setup.py
# header comment for the step-by-step. Leave blank if you'll do admin work manually.
SHOPIFY_ADMIN_API_TOKEN=shpat_REPLACE_ME
